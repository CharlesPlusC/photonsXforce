# Blender 3.5.1
# www.blender.org
mtllib cuboid.mtl
o Cube.001
v 0.000000 0.500000 -1.000000
v 1.000000 0.500000 1.000000
v 1.000000 0.500000 -1.000000
v 0.000000 -0.500000 1.000000
v 1.000000 -0.500000 1.000000
v 0.000000 0.500000 1.000000
v 0.000000 -0.500000 -1.000000
v 1.000000 -0.500000 -1.000000
vn -0.0000 1.0000 -0.0000
vn -0.0000 -0.0000 1.0000
vn -1.0000 -0.0000 -0.0000
vn -0.0000 -1.0000 -0.0000
vn 1.0000 -0.0000 -0.0000
vn -0.0000 -0.0000 -1.0000

g Face_1
usemtl Default_OBJ
f 1//1 2//1 3//1
f 1//1 6//1 2//1

g Face_2
usemtl Default_OBJ
f 2//2 4//2 5//2
f 2//2 6//2 4//2

g Face_3
usemtl Default_OBJ
f 6//3 7//3 4//3
f 6//3 1//3 7//3

g Face_4
usemtl Default_OBJ
f 8//4 4//4 7//4
f 8//4 5//4 4//4

g Face_5
usemtl Default_OBJ
f 3//5 5//5 8//5
f 3//5 2//5 5//5

g Face_6
usemtl Default_OBJ
f 1//6 8//6 7//6
